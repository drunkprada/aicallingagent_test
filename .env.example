# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=your_key_here

# "claude" (default, needs ANTHROPIC_API_KEY + credits) or "mock" (free,
# regex-based stand-in for testing the pipeline with no API access -- see
# src/ingestion/mock_extractor.py). Every mock-mode candidate is force-flagged
# needs_review since heuristic extraction can't be trusted like Claude's.
EXTRACTION_MODE=claude

