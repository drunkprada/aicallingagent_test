# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=your_key_here

# "openai" (default, needs OPENAI_API_KEY + credits) or "mock" (free,
# regex-based stand-in for testing the pipeline with no API access -- see
# src/ingestion/mock_extractor.py). Every mock-mode candidate is force-flagged
# needs_review since heuristic extraction can't be trusted like the real model's.
EXTRACTION_MODE=openai

# Phase 2 (outbound calling) -- text-to-speech is wired up, dialing isn't yet.
ELEVENLABS_API_KEY=your_key_here
# Optional overrides -- default voice is ElevenLabs' premade "Rachel":
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Added in Phase 2 (outbound calling) once dialing is implemented:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
